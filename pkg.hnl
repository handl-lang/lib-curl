-- lib-curl: package manifest. The .hnl payload is sdkgen output under
-- handl-packages/generated/ (gitignored; regenerated by scripts/hnl-gate.sh
-- from specs/) and is consumed through .handl.toml path deps — the repo
-- ships no src/ modules, so this manifest carries metadata only.
{
  name: "curl",
  description: "sdkgen-generated libcurl FFI bindings — generic ports plus linux-x86_64 adapters.",
  license: "MIT",
  keywords: ["curl", "ffi", "sdkgen", "bindings"],
  homepage: "https://github.com/handl-lang/lib-curl",
}
